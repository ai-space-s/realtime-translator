# Set either provider, or both. Never prefix secret keys with VITE_.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-realtime-translate
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
# Local development defaults. Add authentication before exposing publicly.
HOST=127.0.0.1
PORT=5173
# Set the exact HTTPS origin when running behind a reverse proxy.
APP_ORIGIN=
# Google AI Studio / Gemini Live Translate (server-only key)
GOOGLE_API_KEY=
# GEMINI_API_KEY is also accepted. GOOGLE_API_KEY takes precedence when nonempty.
GOOGLE_TRANSLATION_MODEL=gemini-3.5-live-translate-preview
