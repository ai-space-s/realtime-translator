{
  "name": "between-realtime-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
